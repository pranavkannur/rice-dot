configuration {
    modi: "drun,run,filebrowser";
    show-icons: true;
    icon-theme: "breeze-dark";
    display-drun: "";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 10";
    terminal: "kitty";
}

@theme "/dev/null"

@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @foreground;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 500px;
    border-radius: 16px;
    background-color: @background;
    border: 1px;
    border-color: @border-col;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 20px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @background-alt;
    border-radius: 12px;
    padding: 10px 14px;
}

prompt {
    text-color: @active;
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Search...";
    text-color: @foreground;
    placeholder-color: #6c7086;
    cursor: text;
}

listview {
    lines: 6;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
    fixed-height: false;
}

element {
    padding: 8px 12px;
    border-radius: 10px;
    spacing: 10px;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal, element selected {
    background-color: @selected;
    text-color: @active;
}

element-icon {
    size: 22px;
    cursor: inherit;
}

element-text {
    font: "JetBrainsMono Nerd Font 10";
    text-color: inherit;
    cursor: inherit;
    vertical-align: 0.5;
}
