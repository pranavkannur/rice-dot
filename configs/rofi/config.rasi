configuration {
    modi: "drun,run,filebrowser";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 10";
    terminal: "kitty";
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 500px;
    border-radius: 16px;
    background-color: rgba(30, 30, 46, 0.9);
    border: 1px solid rgba(203, 166, 247, 0.3);
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
    padding: 20px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: rgba(49, 50, 68, 0.8);
    border-radius: 12px;
    padding: 10px 14px;
}

prompt {
    text-color: #cba6f7;
    background-color: transparent;
    margin: 0px 8px 0px 0px;
}

entry {
    placeholder: "Search...";
    text-color: #cdd6f4;
    placeholder-color: #6c7086;
    background-color: transparent;
}

listview {
    lines: 6;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
    fixed-height: false;
    background-color: transparent;
}

element {
    padding: 8px 12px;
    border-radius: 10px;
    spacing: 10px;
    background-color: transparent;
}

element selected {
    background-color: rgba(203, 166, 247, 0.2);
    text-color: #cba6f7;
}

element-icon {
    size: 22px;
    background-color: transparent;
}

element-text {
    font: "JetBrainsMono Nerd Font 10";
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
